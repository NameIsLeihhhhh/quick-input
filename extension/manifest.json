{
  "manifest_version": 3,
  "name": "DSH Quick Bridge",
  "version": "1.1.0",
  "description": "把 QuickInput 浮层里输入的内容直接送进 DSH 的新会话，全程不需要切换窗口。",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:3080/*",
    "http://localhost:3080/*",
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:3080/*", "http://localhost:3080/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH Quick Bridge"
  }
}
